# The structural checker is a library so the CLI deploy path can reuse it as
# the fail-closed runtime gate for TEMPLATE_OVERRIDE files.
cc_library(
    name = "template_check_lib",
    srcs = ["template_check.c"],
    hdrs = ["template_check.h"],
    copts = [
        "-std=gnu23",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    includes = ["."],
    linkstatic = True,
)

cc_binary(
    name = "template_check",
    srcs = ["template_check_main.c"],
    copts = [
        "-std=gnu23",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    data = [
        "//deploy:stackctl-infra.yaml",
        "//deploy:stackctl-operator.yaml",
    ],
    linkstatic = True,
    deps = [":template_check_lib"],
)

