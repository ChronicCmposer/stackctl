load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "testdata/bad_infra_ami_asymmetry.yaml",
    "testdata/bad_infra_ami_asymmetry_unref.yaml",
    "testdata/bad_infra_baked_distribution.yaml",
    "testdata/bad_infra_baked_parent.yaml",
    "testdata/bad_infra_bucket.yaml",
    "testdata/bad_infra_export.yaml",
    "testdata/bad_infra_literal_cidr.yaml",
])

# The structural checker is a library so the CLI deploy path can reuse it as
# the fail-closed runtime gate for TEMPLATE_OVERRIDE files.
cc_library(
    name = "template_check_lib",
    srcs = ["template_check.c"],
    hdrs = ["template_check.h"],
    copts = [
        "-std=gnu23",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    includes = ["."],
    linkstatic = True,
)

cc_binary(
    name = "template_check",
    srcs = ["template_check_main.c"],
    copts = [
        "-std=gnu23",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    data = [
        "//deploy:stackctl-infra.yaml",
        "//deploy:stackctl-operator.yaml",
    ],
    linkstatic = True,
    deps = [":template_check_lib"],
)

cc_test(
    name = "template_check_test",
    srcs = ["template_check_test.c"],
    copts = [
        "-std=gnu23",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    data = [
        "testdata/bad_infra_ami_asymmetry.yaml",
        "testdata/bad_infra_ami_asymmetry_unref.yaml",
        "testdata/bad_infra_baked_distribution.yaml",
        "testdata/bad_infra_baked_parent.yaml",
        "testdata/bad_infra_bucket.yaml",
        "testdata/bad_infra_export.yaml",
        "testdata/bad_infra_literal_cidr.yaml",
        "testdata/bad_operator_action_intrinsic.yaml",
        "testdata/bad_operator_ib_execution_trust.yaml",
        "testdata/bad_operator_missing_bucket_lifecycle.yaml",
        "testdata/bad_operator_missing_bucket_public_access_block.yaml",
        "testdata/bad_operator_missing_imagebuilder_perms.yaml",
        "testdata/bad_operator_missing_user_policy.yaml",
        "testdata/bad_operator_resource_intrinsic.yaml",
        "testdata/bad_operator_runinstances_createaction.yaml",
        "testdata/bad_operator_wildcard.yaml",
        "//deploy:stackctl-infra.yaml",
        "//deploy:stackctl-operator.yaml",
    ],
    linkopts = ["-static"],
    linkstatic = True,
    deps = [":template_check_lib"],
)
