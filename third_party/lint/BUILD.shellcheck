# Overlay for the statically linked shellcheck release binary.
#
# The archives are fetched by MODULE.bazel as http_archive repos
# `shellcheck_amd64` and `shellcheck_arm64` (strip_prefix =
# "shellcheck-v<ver>"). This build file only exports the binary; each
# version/distribution is pinned by its http_archive sha256.

package(default_visibility = ["//visibility:public"])

exports_files(["shellcheck"])
