load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# core/iam — AWS IAM + STS Query-protocol request builders and XML response
# parsers over core/aws (CONTRACT Amendment 6, orchestrator-directed extension
# outside the frozen lane map). No network symbols of its own: every call goes
# through the core/aws seam.
cc_library(
    name = "iam",
    srcs = ["iam.c"],
    hdrs = [
        "iam.h",
        "iam_internal.h",
    ],
    copts = [
        "-std=gnu23",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    features = ["-supports_dynamic_linker"],
    includes = ["."],
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = ["//core/aws"],
)

cc_test(
    name = "iam_test",
    srcs = ["iam_test.c"],
    copts = [
        "-std=gnu23",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    features = ["-supports_dynamic_linker"],
    linkopts = ["-static"],
    linkstatic = True,
    deps = [":iam"],
)
