load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# Pure-C ssh(1)/scp(1) exec layer: shared argv contract, sentinel parsing,
# reconnect-once, process-group teardown. No libssh, no network deps.
cc_library(
    name = "ssh",
    srcs = ["ssh.c"],
    hdrs = ["ssh.h"],
    copts = [
        "-std=gnu23",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    linkstatic = True,
    visibility = ["//visibility:public"],
)

cc_test(
    name = "ssh_test",
    srcs = ["ssh_test.c"],
    copts = [
        "-std=gnu23",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    linkopts = ["-static"],
    linkstatic = True,
    deps = [":ssh"],
)
