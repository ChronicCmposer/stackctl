load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# `stackctl terminate` — sweep/instance terminate, bounded waiter, unconditional
# DDNS park and known-hosts forget (spec §4 terminate).
cc_library(
    name = "terminate",
    srcs = ["terminate.c"],
    hdrs = [
        "terminate.h",
        "terminate_internal.h",
    ],
    copts = [
        "-std=gnu23",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    features = ["-supports_dynamic_linker"],
    includes = ["."],
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [
        "//core/cli/common:cli",
        "//core/cli/launch/common:instance_common",
        "//core/ec2",
        "//core/knownhosts",
        "//core/ssm",
        "//core/state",
    ],
)

cc_test(
    name = "terminate_test",
    srcs = ["terminate_test.c"],
    copts = [
        "-std=gnu23",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    features = ["-supports_dynamic_linker"],
    linkopts = ["-static"],
    linkstatic = True,
    deps = [":terminate"],
)
