load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# Pure-C state store: XDG namespace, exclusive flock, binding map, logs.
# No network, no third-party deps.
cc_library(
    name = "state",
    srcs = ["state.c"],
    hdrs = ["state.h"],
    copts = [
        "-std=gnu23",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    linkstatic = True,
    visibility = ["//visibility:public"],
)

cc_test(
    name = "state_test",
    srcs = ["state_test.c"],
    copts = [
        "-std=gnu23",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    linkopts = ["-static"],
    linkstatic = True,
    deps = [":state"],
)
