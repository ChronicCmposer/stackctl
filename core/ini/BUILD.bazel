load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# Pure-C INI upsert: timestamped backup + atomic section-preserving write.
# No network, no third-party deps.
cc_library(
    name = "ini",
    srcs = ["ini.c"],
    hdrs = ["ini.h"],
    copts = [
        "-std=gnu23",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    linkstatic = True,
    visibility = ["//visibility:public"],
)

cc_test(
    name = "ini_test",
    srcs = ["ini_test.c"],
    copts = [
        "-std=gnu23",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    linkopts = ["-static"],
    linkstatic = True,
    deps = [":ini"],
)
