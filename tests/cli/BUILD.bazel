load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Built-binary verb test: drives `status --json` through the real binary against
# an in-test loopback HTTP server selected with STACKCTL_ENDPOINT_URL.
cc_test(
    name = "binary_verb_test",
    srcs = ["binary_verb_test.c"],
    copts = [
        "-std=gnu23",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    data = ["//core/cli/dispatch:stackctl"],
    features = ["-supports_dynamic_linker"],
    linkopts = ["-static"],
    linkstatic = True,
)

# Guide-example honesty test: runs the command examples the maintainer guides
# document (--version, --help, a fail-closed config error, and a valid draft
# config that reaches the bazel preflight). No network, no real credentials.
cc_test(
    name = "guide_examples_test",
    srcs = ["guide_examples_test.c"],
    copts = [
        "-std=gnu23",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    data = [
        "//:VERSION",
        "//core/cli/dispatch:stackctl",
    ],
    features = ["-supports_dynamic_linker"],
    linkopts = ["-static"],
    linkstatic = True,
)

# Process-level contract test: the built binary's exit-code surface.
sh_test(
    name = "cli_contract_test",
    srcs = ["cli_contract_test.sh"],
    args = [
        "$(rootpath //core/cli/dispatch:stackctl)",
        "$(rootpath //:VERSION)",
    ],
    data = [
        "//:VERSION",
        "//core/cli/dispatch:stackctl",
    ],
)
